DATABASE_URL=postgresql+psycopg://bsl_app:change-this-local-dev-password@127.0.0.1:5432/bsl_results_analysis
POSTGRES_USER=bsl_app
POSTGRES_PASSWORD=change-this-local-dev-password
POSTGRES_DB=bsl_results_analysis

# UI origins allowed to call the API with cookies (comma-separated, no trailing slash)
CORS_ORIGINS=http://localhost:4200

# Where the API redirects the browser after Google SSO (the UI origin)
UI_BASE_URL=http://localhost:4200

# Google SSO (OAuth "Web application" client). Keep the secret only in .env,
# never commit it. Register GOOGLE_REDIRECT_URI under "Authorized redirect URIs".
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
# Optional: restrict Google sign-in to Workspace domains (comma-separated).
GOOGLE_ALLOWED_DOMAINS=

# Sessions (minutes)
SESSION_ABSOLUTE_MINUTES=480
SESSION_IDLE_MINUTES=120
# Secure cookies. Browsers accept these on http://localhost; only set to
# false if you serve dev over a non-localhost plain-HTTP host.
COOKIE_SECURE=true

# Per-account lockout after repeated wrong passwords
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
